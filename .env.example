# ---- App ----
APP_NAME=AegisAI
ENV=development
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=aegis
MYSQL_PASSWORD=aegis_password
MYSQL_DATABASE=aegis_governance
DATABASE_URL=mysql+pymysql://aegis:aegis_password@localhost:3306/aegis_governance

# ---- Groq ----
GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ---- Pinecone ----
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=aegis-governance-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=aegis-governance

# ---- Governance thresholds ----
RISK_BLOCK_THRESHOLD=75
GROUNDING_MIN_SCORE=0.55
TOXICITY_BLOCK_THRESHOLD=0.7

# ---- Auth ----
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
